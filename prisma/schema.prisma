// لوکسا (Luxa) — Phase 2 backend schema
// Mirrors the 5 Django apps:
//   accounts  → User, Session, OtpCode, Address
//   products  → Category (tree), Brand, Product, ProductVariant (stock)
//   cart      → Cart, CartItem
//   orders    → Order, OrderItem (fixed invoice pricing)
//   payments  → Transaction (Shaparak Request/Verify)
//   + DiscountCode (campaigns)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── accounts ─────────────────────────────
// Phone-based auth (USERNAME_FIELD equivalent) — AbstractUser override.
model User {
  id           String    @id @default(cuid())
  phone        String    @unique // USERNAME_FIELD
  nationalId   String?
  email        String?
  firstName    String?
  lastName     String?
  fullName     String?
  passwordHash String? // optional fixed password (remember me)
  isStaff      Boolean   @default(false) // /admin access
  isSuperuser  Boolean   @default(false)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  addresses Address[]
  orders    Order[]
  sessions  Session[]
  cart      Cart?
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  code      String
  purpose   String   @default("login")
  attempts  Int      @default(0)
  consumed  Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone])
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipient String
  phone     String
  province  String
  city      String
  postal    String
  detail    String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  orders Order[]
}

// ───────────────────────────── products ─────────────────────────────
model Category {
  id        String     @id @default(cuid())
  title     String
  slug      String     @unique
  image     String?
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  products  Product[]
  createdAt DateTime   @default(now())
}

model Brand {
  id        String    @id @default(cuid())
  name      String    @unique
  nameEn    String?
  logoText  String?
  image     String?
  products  Product[]
  createdAt DateTime  @default(now())
}

model Product {
  id           String           @id @default(cuid())
  name         String
  nameEn       String?
  slug         String           @unique
  sku          String           @unique
  brandId      String?
  brand        Brand?           @relation(fields: [brandId], references: [id])
  categoryId   String?
  category     Category?        @relation(fields: [categoryId], references: [id])
  description  String
  price        Int // toman, current selling price
  oldPrice     Int? // original price when discounted
  image        String
  hoverImage   String?
  rating       Float            @default(0)
  reviewCount  Int              @default(0)
  isNew        Boolean          @default(false)
  isBestseller Boolean          @default(false)
  isSpecial    Boolean          @default(false)
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  variants    ProductVariant[]
  cartItems   CartItem[]
  orderItems  OrderItem[]
}

// Key inventory unit: every color×size combination has independent stock + optional price.
model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  colorName String
  colorHex  String
  size      String
  stock     Int      @default(0)
  price     Int? // override; null → use product.price
  sku       String?
  createdAt DateTime @default(now())

  cartItems  CartItem[]
  orderItems OrderItem[]

  @@unique([productId, colorName, size])
}

// ───────────────────────────── cart ─────────────────────────────
model Cart {
  id         String     @id @default(cuid())
  userId     String?    @unique
  user       User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionKey String?    @unique
  items      CartItem[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model CartItem {
  id         String           @id @default(cuid())
  cartId     String
  cart       Cart             @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId  String
  product    Product          @relation(fields: [productId], references: [id])
  variantId  String?
  variant    ProductVariant?  @relation(fields: [variantId], references: [id])
  colorName  String
  colorHex   String
  size       String
  unitPrice  Int
  qty        Int              @default(1)
  createdAt  DateTime         @default(now())
}

// ───────────────────────────── orders ─────────────────────────────
model Order {
  id              String         @id @default(cuid())
  code            String         @unique // LX-12345
  userId          String
  user            User           @relation(fields: [userId], references: [id])
  addressId       String?
  address         Address?       @relation(fields: [addressId], references: [id])
  addressSnapshot String? // JSON of address at purchase time
  subtotal        Int
  discount        Int            @default(0)
  shipping        Int            @default(0)
  total           Int
  status          String         @default("pending") // pending|paid|preparing|shipped|delivered|cancelled
  shippingMethod  String?
  deliverySlot    String?
  trackingCode    String? // postal tracking (set by admin)
  note            String?
  items           OrderItem[]
  transactions    Transaction[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([status])
}

// Fixed invoice pricing: prices/variants are snapshotted so historical invoices never change.
model OrderItem {
  id        String           @id @default(cuid())
  orderId   String
  order     Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product          @relation(fields: [productId], references: [id])
  variantId String?
  variant   ProductVariant?  @relation(fields: [variantId], references: [id])
  name      String
  brand     String
  image     String
  colorName String
  colorHex  String
  size      String
  unitPrice Int
  qty       Int
  createdAt DateTime         @default(now())
}

// ───────────────────────────── payments ─────────────────────────────
model Transaction {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  authority String? // token from Shaparak Request
  refId     String? // bank tracking code after Verify
  amount    Int
  status    String   @default("requested") // requested|verified|failed|cancelled
  gateway   String   @default("shaparak")
  message   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authority])
}

// ───────────────────────────── discounts / campaigns ─────────────────────────────
model DiscountCode {
  id          String    @id @default(cuid())
  code        String    @unique
  type        String // percent | fixed
  value       Int // percent (0-100) or fixed toman
  maxUses     Int       @default(0) // 0 = unlimited
  uses        Int       @default(0)
  expiresAt   DateTime?
  isActive    Boolean   @default(true)
  minSubtotal Int       @default(0)
  createdAt   DateTime  @default(now())
}
