# Django backend — environment configuration
# Copy to .env and adjust. Load via your deployment (e.g., systemd, Docker, or a .env loader).

# Core
DEBUG=1
SECRET_KEY=change-this-to-a-random-50-char-string-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,*

# CORS: comma-separated list of frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database (default: SQLite at db.sqlite3). For PostgreSQL:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=luxa
# DB_USER=luxa
# DB_PASSWORD=secret
# DB_HOST=localhost
# DB_PORT=5432

# Shaparak payment gateway
# demo = simulates bank callback locally (no real charge)
# live = real Zarinpal/PSP calls
SHAPARAK_MODE=demo
SHAPARAK_MERCHANT_ID=00000000-0000-0000-0000-000000000000
# SHAPARAK_REQUEST_URL=https://api.zarinpal.com/pg/v4/payment/request.json
# SHAPARAK_VERIFY_URL=https://api.zarinpal.com/pg/v4/payment/verify.json
# SHAPARAK_REDIRECT_BASE=https://www.zarinpal.com/pg/StartPay/

# Public base URL (used to build the payment callback URL)
PUBLIC_BASE_URL=http://localhost:8000

# Production cookie security (set to 1 when serving over HTTPS)
# SESSION_COOKIE_SECURE=1
# CSRF_COOKIE_SECURE=1
# SESSION_COOKIE_SAMESITE=None
# CSRF_COOKIE_SAMESITE=None
